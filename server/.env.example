# 复制为 .env 或在启动前注入环境变量；仓库内不得提交真实密码。
# 后端只从环境变量读连接信息，application.yml 中没有任何默认凭证。

# MySQL 8 连接串（库名 hx1948 需先创建，见 sql/00_create_database.sql；建表由 application.yml 的 schema.sql 启动时自动执行）
DB_URL=jdbc:mysql://127.0.0.1:3306/hx1948?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# 数据库账号（建议单独建一个只有 hx1948 库权限的账号，不要用 root）
DB_USERNAME=hx_app

# 数据库密码
DB_PASSWORD=

# 可选：JDBC 驱动。默认 com.mysql.cj.jdbc.Driver；仅无 MySQL 凭证时用 H2 开发库（需 -P dev-h2）才改成 org.h2.Driver
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# 可选：服务端口与允许的前端来源（逗号分隔，只放本机端口；手机局域网同源访问不需要加 CORS）
# SERVER_PORT=8080
# HX_CORS_ORIGINS=http://localhost:8016,http://127.0.0.1:8016,http://localhost:8090,http://127.0.0.1:8090
